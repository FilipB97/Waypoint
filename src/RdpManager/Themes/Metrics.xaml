<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Design tokens: promienie zaokrągleń, skala fontów (tekst i ikony), marginesy okien dialogowych.
         Stałe, niezależne od motywu Dark/Light — w odróżnieniu od Palette.*.xaml NIE są podmieniane
         w runtime (ThemeManager.SwapPalette dopasowuje po "Palette." w URI źródła), więc StaticResource
         (nie DynamicResource) jest tu właściwym wyborem (2.1/2.2/2.4/2.5 z przeglądu). -->

    <!-- Promienie zaokrągleń (Compass §2: 4 / 7 / 9 / 14) -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">7</CornerRadius>
    <CornerRadius x:Key="RadiusMd">9</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>

    <!-- Skala fontów: tekst czytelny (podpisy → nagłówki). Dostrojona do Compass §2 (Body 13, BodyLg 15,
         Subtitle 18, Heading 22); tekst niosący informację ≥ 12 (REVIEW 1.6). FontMicro pozostaje dla
         czysto dekoracyjnych glifów. -->
    <sys:Double x:Key="FontMicro">7.5</sys:Double>
    <sys:Double x:Key="FontCaption">11</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontBodyLg">15</sys:Double>
    <sys:Double x:Key="FontSubtitle">16</sys:Double>
    <sys:Double x:Key="FontTitle">18</sys:Double>
    <sys:Double x:Key="FontHeading">20</sys:Double>
    <sys:Double x:Key="FontDisplay">22</sys:Double>
    <!-- Duża liczba na kafelku statystyki (pulpit). Osobny stopień, bo to nie nagłówek tekstu tylko
         wartość do rzucenia okiem. Był wpisany na sztywno w dwóch miejscach jako 25 i 26 — ten sam
         element w dwóch rozmiarach, bez powodu. -->
    <sys:Double x:Key="FontStat">26</sys:Double>

    <!-- Skala fontów: glify ikon (SymbolIcon / znaki Unicode użyte jako ikony) — osobna skala,
         bo rozmiar ikony dobiera się do przycisku/kontenera, nie do hierarchii czytelnego tekstu. -->
    <sys:Double x:Key="IconXs">11</sys:Double>
    <sys:Double x:Key="IconSm">14</sys:Double>
    <sys:Double x:Key="IconMd">16</sys:Double>
    <sys:Double x:Key="IconLg">18</sys:Double>
    <sys:Double x:Key="IconXl">34</sys:Double>

    <!-- Skala odstępów. Powód: składowe Margin/Padding w XAML-u chodziły po wartościach 1,3,5,7,9,11
         obok 2,4,6,8,10,12 — czyli różnice o piksel, których nikt nie zaprojektował, a które łamią
         wspólną linię między sąsiadującymi widokami. Baza to 4 (4/8/12/16/20/24), z półkrokiem 2
         (2/6/10/14/18) dla gęstych miejsc: wierszy list, pasków narzędzi, wnętrz kontrolek.
         Zasada: nowy i edytowany kod bierze wartość z tej drabiny, nie z oka. Tokeny są Double,
         bo Thickness w WPF nie składa się z zasobów — służą do wyliczeń w kodzie i jako słownik
         dozwolonych wartości przy pisaniu XAML-a. -->
    <sys:Double x:Key="Space2">2</sys:Double>
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space6">6</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space10">10</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>

    <!-- Marginesy okien dialogowych: warianty, które już się pokrywały między kilkoma oknami (2.4) -->
    <Thickness x:Key="DialogContentMargin">18,8,18,8</Thickness>
    <Thickness x:Key="DialogButtonRowMargin">18,4,18,16</Thickness>
    <Thickness x:Key="DialogContentMarginTight">18,4,18,4</Thickness>

    <!-- Karta (uniesiona powierzchnia na treść). Przeniesiona tu z MainWindow.Resources, bo używa jej też
         okno sesji (karta stanu „łączenie / rozłączono") — a to ta sama sesja, tylko wypięta do osobnego
         okna, więc nie może wyglądać inaczej. Pędzle przez DynamicResource: podążają za motywem. -->
    <!-- Uniesienie zamiast obramowania: ramka hairline NA TLE panelu to były dwa sposoby powiedzenia
         „to jest karta". Zostaje sama powierzchnia i miękki cień — karta leży na tle, zamiast być z niego
         wycięta. Kart jest kilka (stan sesji, „O aplikacji"), więc koszt efektu jest bez znaczenia; nie
         nadaje się to natomiast na długie listy powtarzalnych elementów.
         UWAGA: powierzchnią jest Panel, NIE Elevated. Elevated znaczy „krok kontrastu od tła" i ma
         przeciwny znak w obu motywach (ciemny: 13% bieli, jasny: 8% czerni) — na jasnym karta wyszłaby
         CIEMNIEJSZA niż strona, czyli dziura z cieniem zamiast uniesienia. Panel jest jaśniejszy od kanwy
         w obu motywach, a uniesienie i tak niesie cień. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.34" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
