<ui:FluentWindow x:Class="RdpManager.FileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource S.edit.title}" Width="1100" Height="740" MinWidth="560" MinHeight="360"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="{DynamicResource S.edit.title}"/>

        <!-- Nagłówek: ścieżka pliku na serwerze + akcje. -->
        <Grid Grid.Row="1" Margin="16,0,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="{StaticResource FontTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrim}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PathText" Margin="0,2,0,0" FontSize="{StaticResource FontSmall}"
                           Foreground="{DynamicResource TextTer}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="WrapBtn" Appearance="Transparent" Click="Wrap_Click" Padding="8,6"
                           ToolTip="{DynamicResource S.edit.wrap}" AutomationProperties.Name="{DynamicResource S.edit.wrap}">
                    <ui:SymbolIcon Symbol="TextWrap24"/>
                </ui:Button>
                <ui:Button x:Name="ReloadBtn" Appearance="Transparent" Click="Reload_Click" Padding="8,6" Margin="4,0,0,0"
                           ToolTip="{DynamicResource S.edit.reload}" AutomationProperties.Name="{DynamicResource S.edit.reload}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                </ui:Button>
                <ui:Button x:Name="SaveCopyBtn" Appearance="Transparent" Click="SaveCopy_Click" Padding="8,6" Margin="4,0,0,0"
                           ToolTip="{DynamicResource S.edit.savecopy}" AutomationProperties.Name="{DynamicResource S.edit.savecopy}">
                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                </ui:Button>
                <ui:Button x:Name="SaveBtn" Appearance="Primary" Click="Save_Click" Margin="10,0,0,0" IsEnabled="False"
                           ToolTip="Ctrl+S">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource S.edit.save}"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Pasek „tylko do odczytu": dlaczego i jak mimo to edytować (uprawnienia to tylko przypuszczenie). -->
        <Border x:Name="Banner" Grid.Row="2" Visibility="Collapsed" Margin="16,0,16,8" Padding="12,8"
                CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource AccentSoft}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource TextPrim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="BannerText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrim}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="SudoBtn" Appearance="Secondary" Margin="10,0,0,0" Visibility="Collapsed"
                               Click="EditWithSudo_Click" Content="{DynamicResource S.edit.ro.sudo}"/>
                    <ui:Button x:Name="BannerBtn" Appearance="Secondary" Margin="8,0,0,0"
                               Click="EditAnyway_Click" Content="{DynamicResource S.edit.ro.anyway}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="16,0,16,0" CornerRadius="{StaticResource RadiusMd}" ClipToBounds="True"
                BorderThickness="1" BorderBrush="{DynamicResource Border}">
            <Grid>
                <wv2:WebView2 x:Name="Web"/>
                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTer}" Text="{DynamicResource S.edit.loading}"/>
            </Grid>
        </Border>

        <!-- Stopka: komunikat ostatniej operacji po lewej, pozycja/kodowanie/końce linii/język po prawej. -->
        <Grid Grid.Row="4" Margin="16,6,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource TextTer}"/>
            <TextBlock x:Name="InfoText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource TextTer}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
